---
// /recaps/2023/ jumps to that season's last week.
import { getData } from "../../../lib/data.js";
export function getStaticPaths() {
  return getData().seasons.filter((s) => s.weeks.length).map((s) => ({ params: { year: String(s.year) } }));
}
const s = getData().seasonByYear[Number(Astro.params.year)];
const to = `/recaps/${s.year}/${s.weeks.at(-1)}/`;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${to}`} /><link rel="canonical" href={to} /><title>{s.year} recaps</title></head>
<body><a href={to}>Go to {s.year} week {s.weeks.at(-1)}</a></body></html>
